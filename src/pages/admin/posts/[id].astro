---
import { env } from "cloudflare:workers";
import AdminChrome from "@components/admin/AdminChrome.astro";
import PostEditor from "@components/admin/PostEditor.astro";
import { getAdminPost } from "@lib/admin-posts";
import { getSessionFromRequest } from "@lib/auth/session";

const user = await getSessionFromRequest(Astro.request, env);
if (!user) {
	return Astro.redirect("/admin/login");
}

const rawId = Astro.params.id ?? "";
if (!/^[1-9]\d*$/.test(rawId)) {
	return new Response("Not Found", { status: 404 });
}
const post = await getAdminPost(Number(rawId));
if (!post) {
	return new Response("Not Found", { status: 404 });
}
---

<AdminChrome loggedIn title={`Edit ${post.title}`}>
	<PostEditor isNew={false} post={post} />
</AdminChrome>
