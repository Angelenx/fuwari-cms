---
import { env } from "cloudflare:workers";
import PostEditor from "@components/admin/PostEditor.astro";
import { getSessionFromRequest } from "@lib/auth/session";
import "@/styles/tailwind.css";

const user = await getSessionFromRequest(Astro.request, env);
if (!user) {
	return Astro.redirect("/admin/login");
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>New post</title>
	</head>
	<body class="min-h-screen bg-zinc-100 text-zinc-900 p-4">
		<PostEditor isNew username={user.username} />
	</body>
</html>
