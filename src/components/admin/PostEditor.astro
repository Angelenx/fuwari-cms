---
import type { AdminPost } from "@lib/admin-posts";
import { POST_LANG_OPTIONS, parsePostLang } from "@lib/post-lang";

interface Props {
	isNew: boolean;
	post?: AdminPost;
}

const { isNew, post } = Astro.props;
---

<p class="text-sm text-[var(--btn-content)]">
	<a class="link text-[var(--primary)]" href="/admin">All posts</a>
</p>
<form class="space-y-3 card-base p-6" id="post-form">
	<label class="block text-sm">
		Title
		<input
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			name="title"
			required
			value={post?.title ?? ""}
		/>
	</label>
	<label class="block text-sm">
		Slug
		<input
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2 font-mono text-sm"
			name="slug"
			pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
			required
			value={post?.slug ?? ""}
		/>
	</label>
	<label class="block text-sm">
		Description
		<input
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			name="description"
			value={post?.description ?? ""}
		/>
	</label>
	<label class="block text-sm">
		Tags (comma separated)
		<input
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			name="tags"
			value={post?.tags.join(", ") ?? ""}
		/>
	</label>
	<label class="block text-sm">
		Category
		<input
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			name="category"
			value={post?.category ?? ""}
		/>
	</label>
	<label class="block text-sm">
		Cover URL
		<input
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			name="coverUrl"
			value={post?.coverUrl ?? ""}
		/>
	</label>
	<label class="block text-sm">
		Lang
		<select
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			name="lang"
		>
			{
				POST_LANG_OPTIONS.map((option) => (
					<option
						selected={(post?.lang ?? "en") === option.value}
						value={option.value}
					>
						{option.label}
					</option>
				))
			}
			{
				post?.lang &&
					parsePostLang(post.lang) === undefined && (
						<option selected value={post.lang}>
							{post.lang}
						</option>
					)
			}
		</select>
	</label>
	<label class="block text-sm">
		Status
		<select
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			name="status"
		>
			<option selected={post?.status !== "published"} value="draft">
				draft
			</option>
			<option selected={post?.status === "published"} value="published">
				published
			</option>
		</select>
	</label>
	<label class="flex items-center gap-2 text-sm">
		<input
			checked
			id="custom-published-at"
			name="customPublishedAt"
			type="checkbox"
		/>
		Custom published time
	</label>
	<label class="block text-sm" id="published-at-wrap">
		Published at
		<input
			class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
			data-iso={post?.publishedAt ?? ""}
			id="published-at"
			name="publishedAt"
			step="60"
			type="datetime-local"
		/>
	</label>
	<label class="block text-sm">
		Markdown
		<textarea
			class="mt-1 min-h-64 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2 font-mono text-sm"
			name="bodyMd"
		>{post?.bodyMd ?? ""}</textarea>
	</label>
	<p class="hidden text-sm text-red-600" id="form-error"></p>
	<div class="flex flex-wrap gap-2">
		<button class="btn-regular rounded-lg px-3 py-2 text-sm" type="submit">
			Save
		</button>
		<button
			class="btn-regular rounded-lg px-3 py-2 text-sm"
			id="preview-btn"
			type="button"
		>
			Preview
		</button>
	</div>
</form>
<dialog
	class="w-[min(48rem,calc(100%-2rem))] max-h-[80vh] overflow-auto rounded-[var(--radius-large)] border-0 bg-[var(--card-bg)] p-6 text-[var(--deep-text)] shadow-lg"
	id="preview-dialog"
>
	<div class="mb-4 flex items-center justify-between gap-3">
		<h2 class="font-medium">Preview</h2>
		<form method="dialog">
			<button class="btn-regular rounded-lg px-3 py-1 text-sm" type="submit">
				Close
			</button>
		</form>
	</div>
	<div
		class="prose dark:prose-invert prose-base custom-md markdown-content !max-w-none"
		id="preview"
	>
	</div>
</dialog>
<script is:inline define:vars={{ isNew, postId: post?.id ?? null }}>
	const form = document.getElementById("post-form");
	const errorEl = document.getElementById("form-error");
	const dialog = document.getElementById("preview-dialog");
	const titleInput = form.elements.namedItem("title");
	const slugInput = form.elements.namedItem("slug");
	let slugTouched = !isNew;
	slugInput.addEventListener("input", () => {
		slugTouched = true;
	});
	titleInput.addEventListener("input", () => {
		if (slugTouched) {
			return;
		}
		slugInput.value = titleInput.value
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/^-+|-+$/g, "");
	});

	function parseStoredDate(value) {
		if (!value) {
			return null;
		}
		const d =
			value.includes("T") || /(?:Z|[+-]\d{2}:\d{2})$/.test(value)
				? new Date(value)
				: new Date(`${value.replace(" ", "T")}Z`);
		return Number.isNaN(d.getTime()) ? null : d;
	}

	function toDatetimeLocal(d) {
		const pad = (n) => String(n).padStart(2, "0");
		return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
	}

	const customToggle = document.getElementById("custom-published-at");
	const publishedInput = document.getElementById("published-at");
	const publishedWrap = document.getElementById("published-at-wrap");
	const storedPublished = parseStoredDate(
		publishedInput.getAttribute("data-iso") ?? "",
	);
	publishedInput.value = toDatetimeLocal(storedPublished ?? new Date());
	function syncPublishedAtUi() {
		const on = customToggle.checked;
		publishedWrap.hidden = !on;
		publishedInput.disabled = !on;
		publishedInput.required = on;
		if (on && !publishedInput.value) {
			publishedInput.value = toDatetimeLocal(new Date());
		}
	}
	customToggle.addEventListener("change", syncPublishedAtUi);
	syncPublishedAtUi();

	function payload() {
		const data = new FormData(form);
		const tags = String(data.get("tags") ?? "")
			.split(",")
			.map((item) => item.trim())
			.filter(Boolean);
		const body = {
			title: data.get("title"),
			slug: data.get("slug"),
			description: data.get("description"),
			tags,
			category: String(data.get("category") ?? "").trim() || null,
			coverUrl: data.get("coverUrl"),
			lang: data.get("lang"),
			status: data.get("status"),
			bodyMd: data.get("bodyMd"),
		};
		if (customToggle.checked) {
			body.publishedAt = new Date(publishedInput.value).toISOString();
		}
		return body;
	}

	dialog.addEventListener("click", (event) => {
		if (event.target === dialog) {
			dialog.close();
		}
	});

	document.getElementById("preview-btn").addEventListener("click", async () => {
		errorEl.classList.add("hidden");
		const res = await fetch("/api/admin/preview", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify({ body_md: payload().bodyMd }),
		});
		if (!res.ok) {
			errorEl.textContent = "Could not render preview.";
			errorEl.classList.remove("hidden");
			return;
		}
		const body = await res.json();
		document.getElementById("preview").innerHTML = body.bodyHtml ?? "";
		dialog.showModal();
	});

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		errorEl.classList.add("hidden");
		const url = isNew ? "/api/admin/posts" : `/api/admin/posts/${postId}`;
		const res = await fetch(url, {
			method: isNew ? "POST" : "PUT",
			headers: { "content-type": "application/json" },
			body: JSON.stringify(payload()),
		});
		const body = await res.json().catch(() => ({}));
		if (!res.ok) {
			window.adminToast(
				false,
				typeof body.error === "string" ? body.error : "Could not save.",
			);
			return;
		}
		if (isNew) {
			window.adminToast(true, "Saved.");
			const dest = `/admin/posts/${body.post.id}`;
			if (window.adminNavigate) {
				void window.adminNavigate(dest);
			} else {
				window.queueAdminToast?.(true, "Saved.");
				location.assign(dest);
			}
			return;
		}
		window.adminToast(true, "Saved.");
	});
</script>
<style>
	#preview-dialog::backdrop {
		background: rgb(0 0 0 / 0.4);
	}
</style>
