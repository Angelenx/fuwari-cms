---
import { env } from "cloudflare:workers";
import AdminChrome from "@components/admin/AdminChrome.astro";
import {
	type AdminPostListItem,
	listAdminPosts,
	listAdminTags,
	parseAdminPostListFilter,
} from "@lib/admin-posts";
import { getSessionFromRequest } from "@lib/auth/session";
import { getSiteSettings } from "@lib/site-settings";

const user = await getSessionFromRequest(Astro.request, env);
if (!user) {
	return Astro.redirect("/admin/login");
}

const filter = parseAdminPostListFilter({
	q: Astro.url.searchParams.get("q"),
	tag: Astro.url.searchParams.get("tag"),
	status: Astro.url.searchParams.get("status"),
});
const hasFilters = Boolean(
	filter.q || filter.tag || (filter.status && filter.status !== "all"),
);
const [posts, tags, { site }] = await Promise.all([
	listAdminPosts(filter),
	listAdminTags(),
	getSiteSettings(),
]);

type YearGroup = { label: string; posts: AdminPostListItem[] };

function groupByPublishedYear(items: AdminPostListItem[]): YearGroup[] {
	const byYear = new Map<string, AdminPostListItem[]>();
	const unpublished: AdminPostListItem[] = [];
	for (const post of items) {
		if (!post.publishedAt) {
			unpublished.push(post);
			continue;
		}
		const year = post.publishedAt.slice(0, 4);
		const bucket = byYear.get(year);
		if (bucket) {
			bucket.push(post);
		} else {
			byYear.set(year, [post]);
		}
	}
	const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a));
	const groups = years.map((year) => ({
		label: year,
		posts: byYear.get(year) ?? [],
	}));
	if (unpublished.length > 0) {
		groups.push({ label: "Unpublished", posts: unpublished });
	}
	return groups;
}

const groups = groupByPublishedYear(posts);
const emptyMessage = hasFilters ? "No posts match." : "No posts yet.";
const clientMarkdown = site.clientMarkdown;
---

<AdminChrome loggedIn title="Posts">
	<div class="flex flex-wrap gap-2" slot="actions">
		<button
			class="btn-regular rounded-lg px-3 py-2 text-sm"
			id="rerender-posts"
			type="button"
		>
			Re-render posts
		</button>
		<a class="btn-regular rounded-lg px-3 py-2 text-sm" href="/admin/posts/new">
			New post
		</a>
	</div>
	<form
		action="/admin"
		class="card-base mb-4 flex flex-wrap items-end gap-3 p-4"
		id="post-filters"
		method="get"
	>
		<label class="min-w-[12rem] flex-1 text-sm">
			Search
			<input
				class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
				name="q"
				placeholder="Title, slug, or body"
				type="search"
				value={filter.q ?? ""}
			/>
		</label>
		<label class="text-sm">
			Status
			<select
				class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
				name="status"
			>
				<option selected={filter.status === "all"} value="all">All</option>
				<option selected={filter.status === "published"} value="published">
					published
				</option>
				<option selected={filter.status === "draft"} value="draft">
					draft
				</option>
			</select>
		</label>
		<label class="text-sm">
			Tag
			<select
				class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
				name="tag"
			>
				<option selected={!filter.tag} value="">All tags</option>
				{
					tags.map((tag) => (
						<option selected={filter.tag === tag.name} value={tag.name}>
							{tag.name} ({tag.count})
						</option>
					))
				}
			</select>
		</label>
		<button class="btn-regular rounded-lg px-3 py-2 text-sm" type="submit">
			Filter
		</button>
	</form>
	{
		posts.length === 0 ? (
			<p class="card-base p-8 text-sm text-[var(--btn-content)]">
				{emptyMessage}
			</p>
		) : (
			<div class="card-base overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="border-b border-[var(--line-color)] text-[var(--btn-content)]">
						<tr>
							<th class="px-4 py-3 font-medium">Title</th>
							<th class="px-4 py-3 font-medium">Slug</th>
							<th class="px-4 py-3 font-medium">Tags</th>
							<th class="px-4 py-3 font-medium">Status</th>
							<th class="px-4 py-3 font-medium">Published</th>
							<th class="px-4 py-3 font-medium">Actions</th>
						</tr>
					</thead>
					<tbody>
						{groups.map((group) => (
							<>
								<tr class="border-b border-[var(--line-color)]">
									<td
										class="px-4 py-3 font-bold text-[var(--primary)]"
										colspan="6"
									>
										{group.label}
										<span class="ml-2 font-normal text-[var(--btn-content)]">
											{group.posts.length}
										</span>
									</td>
								</tr>
								{group.posts.map((post) => (
									<tr class="border-b border-[var(--line-color)] last:border-0">
										<td class="px-4 py-3">
											<a
												class="link text-[var(--primary)]"
												href={`/admin/posts/${post.id}`}
											>
												{post.title}
											</a>
										</td>
										<td class="px-4 py-3 font-mono text-xs">{post.slug}</td>
										<td class="px-4 py-3 text-[var(--btn-content)]">
											{post.tags.length > 0
												? post.tags.map((name) => `#${name}`).join(" ")
												: "—"}
										</td>
										<td class="px-4 py-3">{post.status}</td>
										<td class="px-4 py-3 text-[var(--btn-content)]">
											{post.publishedAt?.slice(0, 10) ?? "—"}
										</td>
										<td class="px-4 py-3">
											<div class="flex flex-wrap gap-2">
												<a
													class="btn-regular rounded-lg px-2 py-1"
													href={`/admin/posts/${post.id}`}
												>
													Edit
												</a>
												<button
													class="btn-regular rounded-lg px-2 py-1"
													data-action="toggle"
													data-id={post.id}
													data-status={post.status}
													type="button"
												>
													{post.status === "published"
														? "Unpublish"
														: "Publish"}
												</button>
												<button
													class="btn-regular rounded-lg px-2 py-1 text-red-700 dark:text-red-400"
													data-action="delete"
													data-id={post.id}
													type="button"
												>
													Delete
												</button>
											</div>
										</td>
									</tr>
								))}
							</>
						))}
					</tbody>
				</table>
			</div>
		)
	}
	<dialog
		class="w-[min(32rem,calc(100%-2rem))] max-h-[80vh] overflow-auto rounded-[var(--radius-large)] border-0 bg-[var(--card-bg)] p-6 text-[var(--deep-text)] shadow-lg"
		id="rerender-dialog"
	>
		<h2 class="mb-3 font-medium">Re-render all posts</h2>
		<p class="mb-2 text-sm text-[var(--btn-content)]">
			This rewrites HTML for every post (including drafts) from stored Markdown,
			using the current renderer.
		</p>
		<ul class="mb-4 list-disc space-y-1 pl-5 text-sm text-[var(--btn-content)]">
			<li>Status, slug, tags, published_at, and updated_at stay the same.</li>
			{
				clientMarkdown ? (
					<li>
						Rendering runs in this browser. Stay on the page; do not leave or
						refresh until it finishes.
					</li>
				) : (
					<li>
						One request processes the whole table. Many posts or large code
						fences can exceed the free Worker CPU limit; a failure writes
						nothing.
					</li>
				)
			}
			<li>
				To change one or two posts, save those posts instead. Do not use this as
				a daily button.
			</li>
		</ul>
		<div class="flex flex-wrap justify-end gap-2">
			<form method="dialog">
				<button class="btn-regular rounded-lg px-3 py-2 text-sm" type="submit">
					Cancel
				</button>
			</form>
			<button
				class="btn-regular rounded-lg px-3 py-2 text-sm text-red-700 dark:text-red-400"
				id="rerender-confirm"
				type="button"
			>
				Re-render
			</button>
		</div>
	</dialog>
	<script is:inline define:vars={{ clientMarkdown }}>
		const filterForm = document.getElementById("post-filters");
		filterForm?.addEventListener("submit", (event) => {
			if (!window.adminNavigate) {
				return;
			}
			event.preventDefault();
			const data = new FormData(filterForm);
			const params = new URLSearchParams();
			const q = String(data.get("q") ?? "").trim();
			if (q) {
				params.set("q", q);
			}
			const status = String(data.get("status") ?? "all");
			if (status === "draft" || status === "published") {
				params.set("status", status);
			}
			const tag = String(data.get("tag") ?? "").trim();
			if (tag) {
				params.set("tag", tag);
			}
			const href = params.size ? `/admin?${params}` : "/admin";
			void window.adminNavigate(href);
		});

		document.getElementById("rerender-posts")?.addEventListener("click", () => {
			const confirmBtn = document.getElementById("rerender-confirm");
			if (confirmBtn) {
				confirmBtn.disabled = false;
			}
			document.getElementById("rerender-dialog")?.showModal();
		});

		document.getElementById("rerender-dialog")?.addEventListener("click", (event) => {
			if (event.target === event.currentTarget) {
				event.currentTarget.close();
			}
		});

		document.getElementById("rerender-confirm")?.addEventListener("click", async () => {
			const dialog = document.getElementById("rerender-dialog");
			const confirmBtn = document.getElementById("rerender-confirm");
			if (confirmBtn) {
				confirmBtn.disabled = true;
			}
			dialog?.close();
			if (clientMarkdown) {
				window.showAdminRenderProgress?.();
				try {
					const listed = await fetch("/api/admin/posts/markdown");
					if (!listed.ok) {
						throw new Error("list failed");
					}
					const listedBody = await listed.json();
					const source = Array.isArray(listedBody.posts) ? listedBody.posts : [];
					window.showAdminRenderProgress?.({ total: source.length });
					const posts = [];
					let n = 0;
					for (const post of source) {
						const rendered = await window.adminRenderMarkdown?.(post.bodyMd ?? "");
						if (!rendered) {
							throw new Error("render failed");
						}
						posts.push({ id: post.id, ...rendered });
						n += 1;
						window.setAdminRenderProgress?.(n);
					}
					const res = await fetch("/api/admin/posts/rerender", {
						method: "POST",
						headers: { "content-type": "application/json" },
						body: JSON.stringify({ posts }),
					});
					const body = await res.json().catch(() => ({}));
					window.hideAdminRenderProgress?.();
					if (!res.ok) {
						if (confirmBtn) {
							confirmBtn.disabled = false;
						}
						window.adminToast?.(
							false,
							typeof body.error === "string" ? body.error : "Could not re-render.",
						);
						return;
					}
					window.queueAdminToast?.(
						true,
						`Re-rendered ${typeof body.count === "number" ? body.count : 0} posts.`,
					);
					location.reload();
				} catch {
					window.hideAdminRenderProgress?.();
					if (confirmBtn) {
						confirmBtn.disabled = false;
					}
					window.adminToast?.(false, "Could not re-render.");
				}
				return;
			}
			window.showAdminRenderProgress?.({ cloud: true });
			let res;
			try {
				res = await fetch("/api/admin/posts/rerender", { method: "POST" });
			} catch {
				window.hideAdminRenderProgress?.();
				if (confirmBtn) {
					confirmBtn.disabled = false;
				}
				window.adminToast?.(false, "Could not re-render.");
				return;
			}
			window.hideAdminRenderProgress?.();
			const body = await res.json().catch(() => ({}));
			if (!res.ok) {
				if (confirmBtn) {
					confirmBtn.disabled = false;
				}
				window.adminToast?.(
					false,
					typeof body.error === "string" ? body.error : "Could not re-render.",
				);
				return;
			}
			window.queueAdminToast?.(
				true,
				`Re-rendered ${typeof body.count === "number" ? body.count : 0} posts.`,
			);
			location.reload();
		});

		document.querySelectorAll("[data-action]").forEach((button) => {
			button.addEventListener("click", async () => {
				const id = button.getAttribute("data-id");
				const action = button.getAttribute("data-action");
				if (action === "delete") {
					if (!confirm("Delete this post?")) {
						return;
					}
					const res = await fetch(`/api/admin/posts/${id}`, {
						method: "DELETE",
					});
					if (!res.ok) {
						window.adminToast?.(false, "Could not delete.");
						return;
					}
					location.reload();
					return;
				}
				const status =
					button.getAttribute("data-status") === "published"
						? "draft"
						: "published";
				const res = await fetch(`/api/admin/posts/${id}`, {
					method: "PUT",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ status }),
				});
				if (!res.ok) {
					window.adminToast?.(false, "Could not update status.");
					return;
				}
				location.reload();
			});
		});
	</script>
	<style>
		#rerender-dialog::backdrop {
			background: rgb(0 0 0 / 0.4);
		}
	</style>
</AdminChrome>
