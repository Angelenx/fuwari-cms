---
import { env } from "cloudflare:workers";
import AdminChrome from "@components/admin/AdminChrome.astro";
import {
	type AdminPostListItem,
	listAdminPosts,
	listAdminTags,
	parseAdminPostListFilter,
} from "@lib/admin-posts";
import { getSessionFromRequest } from "@lib/auth/session";

const user = await getSessionFromRequest(Astro.request, env);
if (!user) {
	return Astro.redirect("/admin/login");
}

const filter = parseAdminPostListFilter({
	q: Astro.url.searchParams.get("q"),
	tag: Astro.url.searchParams.get("tag"),
	status: Astro.url.searchParams.get("status"),
});
const hasFilters = Boolean(
	filter.q || filter.tag || (filter.status && filter.status !== "all"),
);
const [posts, tags] = await Promise.all([
	listAdminPosts(filter),
	listAdminTags(),
]);

type YearGroup = { label: string; posts: AdminPostListItem[] };

function groupByPublishedYear(items: AdminPostListItem[]): YearGroup[] {
	const byYear = new Map<string, AdminPostListItem[]>();
	const unpublished: AdminPostListItem[] = [];
	for (const post of items) {
		if (!post.publishedAt) {
			unpublished.push(post);
			continue;
		}
		const year = post.publishedAt.slice(0, 4);
		const bucket = byYear.get(year);
		if (bucket) {
			bucket.push(post);
		} else {
			byYear.set(year, [post]);
		}
	}
	const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a));
	const groups = years.map((year) => ({
		label: year,
		posts: byYear.get(year) ?? [],
	}));
	if (unpublished.length > 0) {
		groups.push({ label: "Unpublished", posts: unpublished });
	}
	return groups;
}

const groups = groupByPublishedYear(posts);
const emptyMessage = hasFilters ? "No posts match." : "No posts yet.";
---

<AdminChrome loggedIn title="Posts">
	<a
		class="btn-regular rounded-lg px-3 py-2 text-sm"
		href="/admin/posts/new"
		slot="actions"
	>
		New post
	</a>
	<form
		action="/admin"
		class="card-base mb-4 flex flex-wrap items-end gap-3 p-4"
		id="post-filters"
		method="get"
	>
		<label class="min-w-[12rem] flex-1 text-sm">
			Search
			<input
				class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
				name="q"
				placeholder="Title, slug, or body"
				type="search"
				value={filter.q ?? ""}
			/>
		</label>
		<label class="text-sm">
			Status
			<select
				class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
				name="status"
			>
				<option selected={filter.status === "all"} value="all">All</option>
				<option selected={filter.status === "published"} value="published">
					published
				</option>
				<option selected={filter.status === "draft"} value="draft">
					draft
				</option>
			</select>
		</label>
		<label class="text-sm">
			Tag
			<select
				class="mt-1 w-full rounded-lg border border-[var(--line-color)] bg-[var(--page-bg)] px-3 py-2"
				name="tag"
			>
				<option selected={!filter.tag} value="">All tags</option>
				{
					tags.map((tag) => (
						<option selected={filter.tag === tag.name} value={tag.name}>
							{tag.name} ({tag.count})
						</option>
					))
				}
			</select>
		</label>
		<button class="btn-regular rounded-lg px-3 py-2 text-sm" type="submit">
			Filter
		</button>
	</form>
	{
		posts.length === 0 ? (
			<p class="card-base p-8 text-sm text-[var(--btn-content)]">
				{emptyMessage}
			</p>
		) : (
			<div class="card-base overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead class="border-b border-[var(--line-color)] text-[var(--btn-content)]">
						<tr>
							<th class="px-4 py-3 font-medium">Title</th>
							<th class="px-4 py-3 font-medium">Slug</th>
							<th class="px-4 py-3 font-medium">Tags</th>
							<th class="px-4 py-3 font-medium">Status</th>
							<th class="px-4 py-3 font-medium">Published</th>
							<th class="px-4 py-3 font-medium">Actions</th>
						</tr>
					</thead>
					<tbody>
						{groups.map((group) => (
							<>
								<tr class="border-b border-[var(--line-color)]">
									<td
										class="px-4 py-3 font-bold text-[var(--primary)]"
										colspan="6"
									>
										{group.label}
										<span class="ml-2 font-normal text-[var(--btn-content)]">
											{group.posts.length}
										</span>
									</td>
								</tr>
								{group.posts.map((post) => (
									<tr class="border-b border-[var(--line-color)] last:border-0">
										<td class="px-4 py-3">
											<a
												class="link text-[var(--primary)]"
												href={`/admin/posts/${post.id}`}
											>
												{post.title}
											</a>
										</td>
										<td class="px-4 py-3 font-mono text-xs">{post.slug}</td>
										<td class="px-4 py-3 text-[var(--btn-content)]">
											{post.tags.length > 0
												? post.tags.map((name) => `#${name}`).join(" ")
												: "—"}
										</td>
										<td class="px-4 py-3">{post.status}</td>
										<td class="px-4 py-3 text-[var(--btn-content)]">
											{post.publishedAt?.slice(0, 10) ?? "—"}
										</td>
										<td class="px-4 py-3">
											<div class="flex flex-wrap gap-2">
												<a
													class="btn-regular rounded-lg px-2 py-1"
													href={`/admin/posts/${post.id}`}
												>
													Edit
												</a>
												<button
													class="btn-regular rounded-lg px-2 py-1"
													data-action="toggle"
													data-id={post.id}
													data-status={post.status}
													type="button"
												>
													{post.status === "published"
														? "Unpublish"
														: "Publish"}
												</button>
												<button
													class="btn-regular rounded-lg px-2 py-1 text-red-700 dark:text-red-400"
													data-action="delete"
													data-id={post.id}
													type="button"
												>
													Delete
												</button>
											</div>
										</td>
									</tr>
								))}
							</>
						))}
					</tbody>
				</table>
			</div>
		)
	}
	<script is:inline>
		const filterForm = document.getElementById("post-filters");
		filterForm?.addEventListener("submit", (event) => {
			if (!window.adminNavigate) {
				return;
			}
			event.preventDefault();
			const data = new FormData(filterForm);
			const params = new URLSearchParams();
			const q = String(data.get("q") ?? "").trim();
			if (q) {
				params.set("q", q);
			}
			const status = String(data.get("status") ?? "all");
			if (status === "draft" || status === "published") {
				params.set("status", status);
			}
			const tag = String(data.get("tag") ?? "").trim();
			if (tag) {
				params.set("tag", tag);
			}
			const href = params.size ? `/admin?${params}` : "/admin";
			void window.adminNavigate(href);
		});

		document.querySelectorAll("[data-action]").forEach((button) => {
			button.addEventListener("click", async () => {
				const id = button.getAttribute("data-id");
				const action = button.getAttribute("data-action");
				if (action === "delete") {
					if (!confirm("Delete this post?")) {
						return;
					}
					const res = await fetch(`/api/admin/posts/${id}`, {
						method: "DELETE",
					});
					if (!res.ok) {
						window.adminToast?.(false, "Could not delete.");
						return;
					}
					location.reload();
					return;
				}
				const status =
					button.getAttribute("data-status") === "published"
						? "draft"
						: "published";
				const res = await fetch(`/api/admin/posts/${id}`, {
					method: "PUT",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ status }),
				});
				if (!res.ok) {
					window.adminToast?.(false, "Could not update status.");
					return;
				}
				location.reload();
			});
		});
	</script>
</AdminChrome>
