{
	"name": "fuwari-cms",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "wrangler types && astro dev",
		"build": "wrangler types && astro check && astro build",
		"preview": "wrangler types && astro preview",
		"deploy": "pnpm build && wrangler deploy",
		"check": "astro check",
		"lint": "biome check ./src ./tests",
		"format": "biome format --write ./src ./tests",
		"test": "wrangler types && vitest run",
		"db:migrate:local": "wrangler d1 migrations apply fuwari-cms --local",
		"db:seed:local": "wrangler d1 execute fuwari-cms --local --yes --file=scripts/seed.sql",
		"preinstall": "npx only-allow pnpm"
	},
	"packageManager": "pnpm@9.14.4",
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/svelte": "^9.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.92",
		"@iconify/svelte": "^5.2.2",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.20",
		"astro": "^7.3.3",
		"astro-icon": "^1.2.0",
		"hast-util-to-string": "^3.0.1",
		"hono": "^4.13.8",
		"katex": "^0.18.7",
		"mdast-util-to-string": "^4.0.0",
		"overlayscrollbars": "^2.16.0",
		"photoswipe": "^5.4.4",
		"postcss-import": "^17.0.0",
		"postcss-nesting": "^14.0.1",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "^0.35.4",
		"stylus": "^0.64.0",
		"svelte": "^5.57.0",
		"tailwindcss": "^3.4.19",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "2.2.5",
		"@cloudflare/vitest-plugin": "^1.1.11",
		"@cloudflare/workers-types": "^5.20260917.1",
		"@types/node": "^22.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.133.0"
	}
}
