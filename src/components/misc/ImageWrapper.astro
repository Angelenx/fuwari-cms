---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { url } from "../../utils/url-utils";

const { id, src, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// Glob is narrowed to bundled image assets: post covers are URLs in this CMS, and Fuwari's `../../**`
// would pull every file under src/ into the Worker bundle.
// Vite glob keys are posix (`../../assets/...`). Do not path.join() with basePath="/" — that is
// absolute and drops the `../../` prefix, which breaks the lookup inside workerd (posix path).
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../assets/**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const relBase =
		basePath && basePath !== "/" ? basePath.replace(/^\/+|\/+$/g, "") : "";
	const globKey = path.posix.normalize(
		relBase ? `../../${relBase}/${src}` : `../../${src}`,
	);
	const file = files[globKey];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${globKey.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

// SSR pages still emit `/_image?href=…` with `<Image>`, and `pnpm preview` / Workers
// have no IMAGES binding. ASSETS.fetch of that endpoint often returns an empty body
// (404). Use the glob's hashed `/_astro/…` URL instead — already in the asset bundle.

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {
		isLocal && img && (
			<img
				alt={alt || ""}
				class={imageClass}
				decoding="async"
				height={img.height}
				src={img.src}
				style={imageStyle}
				width={img.width}
			/>
		)
	}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle}/>}
</div>
