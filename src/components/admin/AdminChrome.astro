---
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { adminTabHref } from "@lib/admin-nav";
import { getSiteSettings } from "@lib/site-settings";
import { url } from "@utils/url-utils";
import { siteConfig } from "@/config";
import {
	AUTO_MODE,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
} from "@/constants/constants";
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "katex/dist/katex.css";
import "@/styles/tailwind.css";
import "@/styles/variables.styl";
import "@/styles/markdown-extend.styl";

interface Props {
	title: string;
	loggedIn?: boolean;
	center?: boolean;
}

const { title, loggedIn = false, center = false } = Astro.props;
const { profile } = await getSiteSettings();
const configHue = siteConfig.themeColor.hue;
const path = Astro.url.pathname;
const currentTab = adminTabHref(path);
const tabs = [
	{ href: "/admin", label: "Posts", current: currentTab === "/admin" },
	{
		href: "/admin/profile",
		label: "Profile",
		current: currentTab === "/admin/profile",
	},
	{ href: "/admin/site", label: "Site", current: currentTab === "/admin/site" },
	{
		href: "/admin/about",
		label: "About",
		current: currentTab === "/admin/about",
	},
	{
		href: "/admin/account",
		label: "Account",
		current: currentTab === "/admin/account",
	},
];
---

<html
	class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	lang="en"
	style={`--hue: ${configHue}`}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<script
			is:inline
			define:vars={{
				DEFAULT_THEME,
				LIGHT_MODE,
				DARK_MODE,
				AUTO_MODE,
				configHue,
			}}
		>
			const theme = localStorage.getItem("theme") || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove("dark");
					break;
				case DARK_MODE:
					document.documentElement.classList.add("dark");
					break;
				case AUTO_MODE:
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
			}
			const hue = localStorage.getItem("hue") || configHue;
			document.documentElement.style.setProperty("--hue", hue);
		</script>
	</head>
	<body class="min-h-screen text-[var(--deep-text)]">
		<div class="admin-chrome border-b border-[var(--line-color)] bg-[var(--card-bg)]">
			<header class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
				<div class="flex min-w-0 items-center gap-3">
					<a
						aria-label={`${profile.name} about page`}
						class="h-10 w-10 shrink-0 overflow-hidden rounded-full"
						href={url("/about/")}
					>
						<ImageWrapper
							alt={`Profile image of ${profile.name}`}
							class="h-10 w-10"
							src={profile.avatar || ""}
						/>
					</a>
					<div class="min-w-0">
						<p class="truncate font-bold">{profile.name}</p>
						<h1
							class="truncate text-sm text-[var(--btn-content)]"
							id="admin-header-title"
						>
							{title}
						</h1>
					</div>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					<div class="flex flex-wrap items-center gap-2" id="admin-actions">
						<slot name="actions" />
					</div>
					{
						loggedIn && (
							<button
								class="btn-regular rounded-lg px-3 py-2 text-sm"
								id="admin-logout"
								type="button"
							>
								Log out
							</button>
						)
					}
				</div>
			</header>
			{
				loggedIn && (
					<nav aria-label="Admin" class="px-4">
						<div class="flex gap-1 overflow-x-auto">
							{tabs.map((tab) => (
								<a
									aria-current={tab.current ? "page" : undefined}
									href={tab.href}
								>
									{tab.label}
								</a>
							))}
						</div>
					</nav>
				)
			}
		</div>
		<main
			class:list={[
				"admin-main",
				center
					? "flex min-h-[calc(100vh-4.5rem)] items-center justify-center p-4"
					: "mx-auto max-w-4xl space-y-6 p-4",
			]}
		>
			<div class="admin-loading" hidden id="admin-loading">
				<div class="admin-loader" aria-label="Loading" role="status">
					<span></span>
					<span></span>
					<span></span>
				</div>
			</div>
			<div
				class:list={["admin-panel", center && "w-full max-w-sm"]}
				id="admin-panel"
			>
				<slot />
			</div>
		</main>
		<p
			class="pointer-events-none fixed left-1/2 top-4 z-50 max-w-[min(24rem,calc(100%-2rem))] -translate-x-1/2 rounded-lg px-4 py-2 text-center text-sm text-white opacity-0 shadow-lg transition-opacity duration-200"
			id="admin-toast"
			role="status"
		>
		</p>
		{
			loggedIn && (
				<dialog
					class="w-[min(28rem,calc(100%-2rem))] rounded-[var(--radius-large)] border-0 bg-[var(--card-bg)] p-6 text-[var(--deep-text)] shadow-lg"
					id="admin-render-progress"
				>
					<p class="mb-4 text-sm">
						Rendering Markdown. Please stay on this page — do not leave or
						refresh.
					</p>
					<div class="admin-render-track" role="progressbar">
						<div class="admin-render-bar is-indeterminate" id="admin-render-bar" />
					</div>
					<p
						class="mt-3 text-center text-sm text-[var(--btn-content)]"
						hidden
						id="admin-render-count"
					/>
				</dialog>
			)
		}
		<script>
			import { bootAdminChrome } from "@lib/admin-chrome";
			bootAdminChrome();
		</script>
		<style is:global>
			nav[aria-label="Admin"] a {
				position: relative;
				flex-shrink: 0;
				padding: 0.5rem 0.75rem;
				color: var(--btn-content);
				font-size: 0.875rem;
				transition: color 0.2s ease;
			}
			nav[aria-label="Admin"] a:hover,
			nav[aria-label="Admin"] a[aria-current="page"] {
				color: var(--primary);
			}
			nav[aria-label="Admin"] a::after {
				content: "";
				position: absolute;
				right: 0.75rem;
				bottom: 0;
				left: 0.75rem;
				height: 2px;
				border-radius: 999px;
				background: var(--primary);
				transform: scaleX(0);
				transition: transform 0.2s ease;
			}
			nav[aria-label="Admin"] a[aria-current="page"]::after {
				transform: scaleX(1);
			}
			.admin-loading:not([hidden]) {
				display: flex;
				min-height: 12rem;
				align-items: center;
				justify-content: center;
			}
			.admin-loader {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				padding: 0.7rem 1.15rem;
				border-radius: 999px;
				background: var(--btn-regular-bg);
			}
			.admin-loader span {
				display: block;
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 999px;
				background: var(--primary);
				animation: admin-loader-dot 0.9s ease-in-out infinite;
			}
			.admin-loader span:nth-child(2) {
				animation-delay: 0.15s;
			}
			.admin-loader span:nth-child(3) {
				animation-delay: 0.3s;
			}
			@keyframes admin-loader-dot {
				0%,
				80%,
				100% {
					opacity: 0.35;
					transform: translateY(0);
				}
				40% {
					opacity: 1;
					transform: translateY(-0.28rem);
				}
			}
			.admin-panel-in {
				animation: admin-panel-in 0.28s ease;
			}
			@keyframes admin-panel-in {
				from {
					opacity: 0;
					transform: translateX(0.75rem);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}
			#admin-render-progress::backdrop {
				background: rgb(0 0 0 / 0.45);
			}
			.admin-render-track {
				height: 0.5rem;
				overflow: hidden;
				border-radius: 999px;
				background: var(--btn-regular-bg);
			}
			.admin-render-bar {
				height: 100%;
				width: 0;
				border-radius: inherit;
				background: var(--primary);
				transition: width 0.2s ease;
			}
			.admin-render-bar.is-indeterminate {
				width: 40%;
				transition: none;
				animation: admin-render-slide 1.2s ease-in-out infinite;
			}
			@keyframes admin-render-slide {
				0% {
					transform: translateX(-120%);
				}
				100% {
					transform: translateX(280%);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				nav[aria-label="Admin"] a::after,
				.admin-loader span,
				.admin-panel-in,
				.admin-render-bar.is-indeterminate {
					animation: none;
					transition: none;
				}
			}
		</style>
	</body>
</html>
